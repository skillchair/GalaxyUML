<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="GalaxyUML.UI.Avalonia.MainWindow"
        Title="GalaxyUML"
        Width="1400" Height="820" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Tahoma, Geneva, Verdana, Arial, sans-serif"
        FontSize="13"
        Foreground="#000000">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation (Classic Web 1.0 / HTML Toolbar) -->
        <Border Grid.Row="0" Background="#F4F4F4" Padding="16,10" BorderBrush="#000000" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & API Endpoint -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GalaxyUML" FontSize="18" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Border BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Height="20" Margin="0,0,20,0" />
                    <TextBlock Text="API Endpoint:" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                    <TextBox x:Name="ApiBaseUrlTextBox" Width="220" Text="http://localhost:5248" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="12" Height="28" Padding="6,3" />
                </StackPanel>

                <!-- User Session Indicator -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="UserBadgeBorder" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SessionStatusText" Text="Niste prijavljeni" Foreground="#000000" FontWeight="Bold" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <Button x:Name="LogoutButton" Content="[ Odjavi se ]" Height="28" Padding="10,2" IsVisible="False" Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="12" Background="#FFFFFF">
            
            <!-- TAB 1: AUTHENTICATION -->
            <TabItem Header="Autentifikacija">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Status Notification Banner -->
                    <Border Grid.Row="0" Background="#FFFFE0" BorderBrush="#000000" BorderThickness="1" Padding="12,8" Margin="0,0,0,16">
                        <TextBlock x:Name="AuthStatusBanner" Text="Prijavite se na postojeći nalog ili registrujte novi za pristup kolaborativnom radu." Foreground="#000000" FontSize="13" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="440" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MaxWidth="500" />
                        </Grid.ColumnDefinitions>

                        <!-- Login Fieldset Box -->
                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="&lt;Prijava na sistem&gt;" FontWeight="Bold" FontSize="15" Foreground="#000000" Margin="0,0,0,16" />

                                <TextBlock Text="Korisničko ime:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="LoginUsernameTextBox" Margin="0,0,0,14" KeyDown="LoginInput_KeyDown" />

                                <TextBlock Text="Lozinka:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="LoginPasswordBox" PasswordChar="●" Margin="0,0,0,20" KeyDown="LoginInput_KeyDown" />

                                <Button Content="Prijavi se" Classes="primary" Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="LoginButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Register Fieldset Box -->
                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="&lt;Kreiranje novog naloga&gt;" FontWeight="Bold" FontSize="15" Foreground="#000000" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ime:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                        <TextBox x:Name="RegisterFirstNameTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Prezime:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                        <TextBox x:Name="RegisterLastNameTextBox" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Korisničko ime:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="RegisterUsernameTextBox" Margin="0,0,0,10" />

                                <TextBlock Text="Email adresa:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="RegisterEmailTextBox" Margin="0,0,0,10" />

                                <TextBlock Text="Lozinka (min. 8 karaktera):" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="RegisterPasswordBox" PasswordChar="●" Margin="0,0,0,18" />

                                <Button Content="Registruj se" Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RegisterButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: TEAMS -->
            <TabItem Header="Timovi">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Create & Join Forms -->
                    <StackPanel Grid.Column="0">
                        <!-- Create Team Box -->
                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Kreiraj novi tim" FontWeight="Bold" FontSize="14" Foreground="#000000" Margin="0,0,0,10" />
                                <TextBlock Text="Naziv tima:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="CreateTeamNameTextBox" Margin="0,0,0,10" />
                                <Button Content="Kreiraj tim" Classes="primary" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="CreateTeamButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Join by Code Box -->
                        <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Učlanjenje preko koda" FontWeight="Bold" FontSize="14" Foreground="#000000" Margin="0,0,0,10" />
                                <TextBlock Text="Kod tima (6 karaktera):" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                                <TextBox x:Name="JoinCodeTextBox" MaxLength="6" FontFamily="Consolas, monospace" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Pronađi" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="FindTeamByCodeButton_Click" />
                                    <Button Grid.Column="2" Content="Učlani se" Classes="primary" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="JoinByCodeButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Status Message Box -->
                        <Border Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" Padding="10" Margin="0,12,0,0">
                            <TextBlock x:Name="TeamStatusText" Text="Izaberite tim za detalje." TextWrapping="Wrap" Foreground="#000000" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Middle: My Teams List -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                                <TextBlock Text="Moji timovi" FontWeight="Bold" FontSize="14" Foreground="#000000" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Button Content="[ Osveži ]" Height="28" Padding="8,2" FontSize="12" DockPanel.Dock="Right" Click="RefreshTeamsButton_Click" />
                            </DockPanel>

                            <ListBox x:Name="TeamsListBox" Grid.Row="1" SelectionChanged="TeamsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding TeamName}" FontWeight="Bold" FontSize="13" Foreground="#000000" />
                                                    <TextBlock Text="{Binding MemberCountText}" Foreground="#444444" FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#EEEEEE" BorderBrush="#000000" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TeamCode}" FontWeight="Bold" Foreground="#000000" FontSize="11" FontFamily="Consolas, monospace" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Napusti tim" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="LeaveTeamButton_Click" />
                                <Button Grid.Column="2" Content="Obriši tim" Classes="danger" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="DeleteTeamButton_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Team Members & Admin Panel -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="SelectedTeamBannerText" Grid.Row="0" Text="Selektujte tim za prikaz članova." FontWeight="Bold" Foreground="#000000" FontSize="14" Margin="0,0,0,10" />

                            <ListBox x:Name="TeamMembersListBox" Grid.Row="1" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#000000" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding FullName}" Foreground="#444444" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Email}" FontFamily="Consolas, monospace" Foreground="#666666" FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#EEEEEE" BorderBrush="#000000" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#000000" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Owner Controls -->
                            <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Administracija člana (Vlasnik tima)" FontWeight="Bold" FontSize="12" Foreground="#000000" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ChangeRoleComboBox" Grid.Column="0" Height="30" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Organizer" />
                                            <ComboBoxItem Content="Member" />
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="Promeni ulogu" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ChangeRoleButton_Click" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BanReasonTextBox" Grid.Column="0" Height="30" Watermark="Razlog banovanja (opciono)" />
                                        <Button Grid.Column="2" Content="Banuj" Classes="danger" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BanMemberButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: MEETINGS -->
            <TabItem Header="Sastanci">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Meeting Launch & Selection -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Sastanak tima" FontWeight="Bold" FontSize="14" Foreground="#000000" Margin="0,0,0,10" />

                            <TextBlock Text="Izaberite tim:" FontWeight="Bold" Foreground="#000000" Margin="0,0,0,4" FontSize="12" />
                            <ComboBox x:Name="MeetingTeamComboBox"
                                      Margin="0,0,0,12"
                                      HorizontalAlignment="Stretch"
                                      Height="32"
                                      SelectionChanged="MeetingTeamComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TeamName}" Foreground="#000000" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="Pokreni novi sastanak" Classes="primary" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="StartMeetingButton_Click" Margin="0,0,0,14" />

                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <TextBlock Text="Aktivni sastanci" FontWeight="Bold" FontSize="13" Foreground="#000000" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                <Button Content="[ Osveži ]" Height="26" Padding="6,2" FontSize="11" DockPanel.Dock="Right" Click="RefreshMeetingsButton_Click" />
                            </DockPanel>

                            <ListBox x:Name="MeetingsListBox" Height="190" Margin="0,0,0,12" SelectionChanged="MeetingsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}" FontWeight="Bold" FontSize="12" Foreground="#000000" />
                                                <TextBlock Text="{Binding TimeText}" FontFamily="Consolas, monospace" Foreground="#444444" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Pridruži se" Classes="primary" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="JoinMeetingButton_Click" />
                                <Button Grid.Column="2" Content="Završi sastanak" Classes="danger" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="EndMeetingButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Active Meeting Details & Participants -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="[ Otvori tablu ]" Classes="primary" Height="30" Padding="14,2" Click="SwitchToDiagramTabButton_Click" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="MeetingStatusText" Text="Nema aktivnog sastanka." FontWeight="Bold" Foreground="#000000" FontSize="13" />
                                        <TextBlock x:Name="BoardInfoText" Text="Tabla: Nije aktivna" Foreground="#444444" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <ListBox x:Name="MeetingParticipantsListBox" Grid.Row="1" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="#000000" />
                                                    <TextBlock Text="{Binding Role}" Foreground="#444444" FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#EEEEEE" BorderBrush="#000000" BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DrawBadgeText}" FontWeight="Bold" Foreground="#000000" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Participant Draw Rights Control -->
                            <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#000000" BorderThickness="1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Kontrola prava crtanja za selektovanog člana (Organizator)" FontWeight="Bold" FontSize="12" Foreground="#000000" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Dozvoli crtanje" Classes="primary" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="GrantDrawButton_Click" />
                                        <Button Grid.Column="2" Content="Oduzmi crtanje" Height="30" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RevokeDrawButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: BOARD / UML DIAGRAM & REAL-TIME CHAT -->
            <TabItem x:Name="DiagramTabItem" Header="Tabla i Chat">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Diagram Toolbar -->
                    <Border Grid.Row="0" Padding="10" Background="#F4F4F4" BorderBrush="#000000" BorderThickness="1" Margin="0,0,0,6">
                        <StackPanel>
                            <!-- Row 1: Tools & Actions & Status -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="Alat:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,6,0" FontSize="12" />
                                    <ComboBox x:Name="ToolComboBox" Width="120" Height="28" Margin="0,0,10,0" SelectedIndex="0" SelectionChanged="ToolComboBox_SelectionChanged">
                                        <ComboBoxItem Content="ClassBox" />
                                        <ComboBoxItem Content="Line" />
                                        <ComboBoxItem Content="Pomeri" />
                                    </ComboBox>

                                    <Button Content="Obriši" Classes="danger" Height="28" Padding="10,2" Margin="0,0,6,0" Click="DeleteSelectedElementButton_Click" />
                                    <Button Content="Očisti tablu" Height="28" Padding="10,2" Margin="0,0,6,0" Click="ClearBoardButton_Click" />
                                    <Button Content="[ Osveži ]" Height="28" Padding="10,2" Click="RefreshBoardButton_Click" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Border x:Name="DrawPermissionBadge" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="6,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="DrawPermissionStatusText" Text="Nema dozvolu za crtanje" FontWeight="Bold" Foreground="#000000" FontSize="11" />
                                    </Border>
                                    <Border x:Name="SignalRBadge" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1" Padding="6,3">
                                        <TextBlock x:Name="SignalRStatusText" Text="SignalR: Isključen" FontWeight="Bold" Foreground="#000000" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <!-- Row 2: Tool parameters -->
                            <StackPanel x:Name="ClassBoxCreationWrap" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Naziv klase:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <TextBox x:Name="NewClassNameTextBox" Width="120" Text="Korisnik" Margin="0,0,10,0" Height="28" FontFamily="Consolas, monospace" />

                                <TextBlock Text="Atributi:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <TextBox x:Name="NewClassAttributesTextBox" Width="200" Text="+ id: int, + username: string" Margin="0,0,10,0" Height="28" FontFamily="Consolas, monospace" />

                                <TextBlock Text="Metode:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <TextBox x:Name="NewClassMethodsTextBox" Width="220" Text="+ login(): bool, + logout(): void" Margin="0,0,10,0" Height="28" FontFamily="Consolas, monospace" />

                                <Button Content="Dodaj ClassBox" Classes="primary" Height="28" Padding="10,2" Click="AddClassBoxDirectButton_Click" Margin="0,0,8,0" />
                                <TextBlock Text="(ili prevucite mišem po tabli)" Foreground="#666666" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>

                            <StackPanel x:Name="LineControlsWrap" Orientation="Horizontal" Margin="0,2,0,0" IsVisible="False">
                                <TextBlock Text="Početna klasa:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <ComboBox x:Name="StartBoxComboBox" Width="160" Margin="0,0,10,0" Height="28">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="#000000" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Krajnja klasa:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <ComboBox x:Name="EndBoxComboBox" Width="160" Margin="0,0,10,0" Height="28">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Display}" Foreground="#000000" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Oznaka veze:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#000000" Margin="0,0,4,0" FontSize="12" />
                                <TextBox x:Name="LineMiddleTextTextBox" Width="120" Margin="0,0,10,0" Height="28" FontFamily="Consolas, monospace" />

                                <Button Content="Poveži linijom" Classes="primary" Height="28" Padding="10,2" Click="CreateLineButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Canvas & Chat Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Canvas (Clean Whiteboard) -->
                        <Border Grid.Column="0" BorderBrush="#000000" BorderThickness="1" Background="#FFFFFF" ClipToBounds="True">
                            <Canvas x:Name="BoardCanvas"
                                    Background="#FFFFFF"
                                    PointerPressed="BoardCanvas_PointerPressed"
                                    PointerMoved="BoardCanvas_PointerMoved"
                                    PointerReleased="BoardCanvas_PointerReleased" />
                        </Border>

                        <!-- Real-Time Chat Pane (Classic Raw HTML / IRC Web Chat) -->
                        <Border Grid.Column="1" BorderBrush="#000000" BorderThickness="1" Background="#F9F9F9" Margin="6,0,0,0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Chat Header -->
                                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="0,0,0,1" Padding="6,4" Margin="0,0,0,6">
                                    <TextBlock Text="Chat sastanka" FontWeight="Bold" Foreground="#000000" FontSize="13" />
                                </Border>

                                <!-- Chat Messages -->
                                <ListBox x:Name="ChatMessagesListBox" Grid.Row="1" Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Padding="6,4">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding SenderUsername}" FontWeight="Bold" FontSize="12" Foreground="#000080" DockPanel.Dock="Left" />
                                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#666666" DockPanel.Dock="Right" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" Foreground="#000000" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Input & Send -->
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChatMessageInputTextBox" Grid.Column="0" Height="30" KeyDown="ChatMessageInputTextBox_KeyDown" />
                                    <Button Grid.Column="2" Content="Pošalji" Classes="primary" Height="30" Width="68" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="SendChatMessageButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
