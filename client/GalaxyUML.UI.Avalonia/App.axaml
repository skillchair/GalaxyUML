<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GalaxyUML.UI.Avalonia.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />

        <!-- Global Oldschool Raw HTML Minimalist Theme Defaults -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Arial, sans-serif" />
        </Style>

        <!-- Classic HTML Input Style -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#0000EE" />
        </Style>

        <!-- Classic HTML Select / Dropdown Style -->
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#F0F0F0" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Classic HTML Button Style -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#E5E5E5" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#D0D0D0" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#B0B0B0" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#EFEFEF" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
        </Style>

        <!-- Classic HTML Action/Primary Button -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Classic Danger Button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#CC0000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#990000" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <!-- Classic ListBox and Items -->
        <Style Selector="ListBox">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#E5EEFF" />
            <Setter Property="Foreground" Value="#000000" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#F2F2F2" />
        </Style>

        <!-- Classic TabControl & TabItems -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Styles>
</Application>
